<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Import Spring Boot default logging settings -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Pull application properties from application.properties or application.yml -->
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="spring-boot-app"/>
    <property name="LOG_PATH" value="logs" />

    <!-- 1. CONSOLE APPENDER (Colorized for local development) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}</pattern>
        </encoder>
    </appender>

    <!-- 2. ROLLING FILE APPENDER (For persistent log tracking) -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${appName}.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} ${LOG_LEVEL_PATTERN:-%5p} ${PID:- } --- [%t] %-40.40logger{39} : %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}</pattern>
        </encoder>
        <!-- Rollover policy: Daily rotation or when a file hits 100MB -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archived/${appName}-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- 3. ENVIRONMENT PROFILES -->
    <!-- Local development: Log to Console only -->
    <springProfile name="dev, local">
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
        </root>
    </springProfile>

    <!-- Production/Staging: Log to Console and Roll Over Files -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>

</configuration>